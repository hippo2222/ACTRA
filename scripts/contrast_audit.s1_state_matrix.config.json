        { "type": "hover", "selector": "#pause-confirm-submit", "waitMs": 120 },
        { "type": "focus", "selector": "#pause-confirm-submit", "waitMs": 120 }
      ]
    },
    {
      "name": "S1 state matrix - resume modal",
      "url": "/ui/session/session_auto_placeholder",
      "autoSession": {
        "preferredIteration": 1,
        "requireNotPaused": true,
        "minTotalTasks": 1,
        "autoCreateWhenEmpty": true,
        "usePreviousSession": true,
        "preferConfiguredUrlSession": false,
        "strict": true
      },
      "waitFor": "#task-content",
      "waitForTimeout": 30000,
      "actionsOnce": [
        {
          "type": "waitForFunction",
          "script": "const s = window.SessionState || {}; const t = s.currentTask || (s.state && s.state.currentTask); return !!t && !s.isLoading;",
          "timeout": 30000
        },
        {
          "type": "s1_seek_task",
          "taskTypes": ["test"],
          "maxSteps": 100,
          "autoSubmitMode": "force_success",
          "afterStepWaitMs": 220,
          "failOnError": false
        }
      ],
      "actions": [
        { "type": "s1_modal", "modal": "resume", "waitMs": 120 },
        { "type": "hover", "selector": "#resume-continue-btn", "waitMs": 120 },
        { "type": "focus", "selector": "#resume-continue-btn", "waitMs": 120 }
      ]
    }
  ]
}

      ],
      "actions": [
        { "type": "s1_modal", "modal": "close", "waitMs": 80 },
        { "type": "s1_review", "mode": "failure", "waitMs": 180, "failOnError": false },
        { "type": "hover", "selector": "#check-answer-btn", "waitMs": 120 },
        { "type": "focus", "selector": "#check-answer-btn", "waitMs": 120 }
      ]
    },
    {
      "name": "S1 state matrix - pause modal",
      "url": "/ui/session/session_auto_placeholder",
      "autoSession": {
        "preferredIteration": 1,
        "requireNotPaused": true,
        "minTotalTasks": 1,

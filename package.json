{
  "name": "actra",
  "version": "1.0.0",
  "description": "ACTRA — frontend build tooling (Tailwind CSS, Vitest)",
  "private": true,
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:frontend": "node scripts/lint_frontend.js",
    "build:css": "npx tailwindcss -i ./frontend/assets/input.css -o ./frontend/assets/tailwind.css --minify",
    "audit:contrast": "node scripts/contrast_audit.js",
    "audit:contrast:s1-matrix": "node scripts/ensure_contrast_s1_seed.js && node scripts/contrast_audit.js --config scripts/contrast_audit.s1_state_matrix.config.json",
    "audit:contrast:editor-theory-p6": "node scripts/contrast_audit.js --config scripts/contrast_audit.editor_theory_p6.config.json",
    "audit:contrast:full": "npm run build:css && node scripts/contrast_audit.js --config scripts/contrast_audit.config.json && node scripts/ensure_contrast_s1_seed.js && node scripts/contrast_audit.js --config scripts/contrast_audit.s1_state_matrix.config.json",
    "audit:contrast:auto": "node scripts/run_contrast_suite.js",
    "smoke:theory-p10": "node scripts/theory_p10_smoke.js",
    "smoke:release": "node scripts/run_browser_smoke_release.js",
    "smoke:release:p0": "node scripts/run_browser_smoke_release.js --suite p0",
    "smoke:release:p1": "node scripts/run_browser_smoke_release.js --suite p1",
    "smoke:release:guardrail": "node scripts/run_browser_smoke_release.js --suite guardrail",
    "smoke:release:gate": "node scripts/run_browser_smoke_release.js --suite p0,p1,guardrail",
    "validate:themes": "node scripts/validate_theme_vars.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.4.17",
    "jsdom": "^27.4.0",
    "playwright": "^1.58.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.0.16"
  }
}

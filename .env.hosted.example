# Copy this file to `.env` on the server and fill in real secrets there.
# Do not commit the real `.env`.

ACTRA_RUNTIME_MODE=hosted_web
ACTRA_BIND_HOST=0.0.0.0
TRAINER_HTTP_PORT=8000

ACTRA_HOSTED_APP_PORT=8000
ACTRA_HOSTED_MAILPIT_HTTP_PORT=8025

ACTRA_HOSTED_DATA_ROOT_HOST=./data
ACTRA_HOSTED_LOGS_ROOT_HOST=./logs
ACTRA_HOSTED_RUNTIME_STATE_ROOT_HOST=./runtime_state

ACTRA_HOSTED_PERSISTENCE_STRICT=1
ACTRA_HOSTED_DEV_AUTH_BRIDGE=0
ACTRA_ENABLE_HOSTED_SHADOW_WRITE_FALLBACK=0

ACTRA_SECRET_KEY=replace-with-long-random-secret

ACTRA_SESSION_COOKIE_SECURE=1
ACTRA_SESSION_COOKIE_SAMESITE=Lax
ACTRA_AUTH_SESSION_TTL_DAYS=30

ACTRA_UPDATE_CHECK_ENABLED=0

ACTRA_AUTH_EMAIL_ENABLED=1
ACTRA_AUTH_PUBLIC_BASE_URL=https://actra.site
ACTRA_AUTH_SMTP_HOST=smtp-relay.brevo.com
ACTRA_AUTH_SMTP_PORT=587
ACTRA_AUTH_SMTP_USER=replace-with-brevo-smtp-login
ACTRA_AUTH_SMTP_FROM=auth@actra.site
ACTRA_AUTH_SMTP_PASSWORD=replace-with-brevo-smtp-key
ACTRA_AUTH_SMTP_USE_TLS=1
ACTRA_AUTH_SMTP_USE_SSL=0

ACTRA_FEEDBACK_EMAIL_ENABLED=1
ACTRA_FEEDBACK_EMAIL_TO=actrafb@proton.me
ACTRA_FEEDBACK_SMTP_HOST=smtp-relay.brevo.com
ACTRA_FEEDBACK_SMTP_PORT=587
ACTRA_FEEDBACK_SMTP_USER=replace-with-brevo-smtp-login
ACTRA_FEEDBACK_SMTP_FROM=auth@actra.site
ACTRA_FEEDBACK_SMTP_PASSWORD=replace-with-brevo-smtp-key
ACTRA_FEEDBACK_SMTP_USE_TLS=1
ACTRA_FEEDBACK_SMTP_USE_SSL=0

POSTGRES_PASSWORD=replace-with-strong-postgres-password
ACTRA_POSTGRES_DSN=postgresql://actra:replace-with-strong-postgres-password@postgres:5432/actra

ACTRA_S3_ENDPOINT=http://minio:9000
ACTRA_S3_BUCKET=actra
ACTRA_S3_ACCESS_KEY=replace-with-minio-access-key
ACTRA_S3_SECRET_KEY=replace-with-minio-secret-key

ACTRA_ADMIN_LOGIN=replace-with-first-admin-login
ACTRA_ADMIN_EMAIL=replace-with-first-admin-email

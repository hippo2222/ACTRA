ACTRA_RUNTIME_MODE=hosted_web
ACTRA_BIND_HOST=127.0.0.1
TRAINER_HTTP_PORT=8000

ACTRA_HOSTED_APP_PORT=8000
ACTRA_HOSTED_MAILPIT_HTTP_PORT=8025

ACTRA_HOSTED_DATA_ROOT_HOST=./data
ACTRA_HOSTED_LOGS_ROOT_HOST=./logs
ACTRA_HOSTED_RUNTIME_STATE_ROOT_HOST=./runtime_state

TRAINER_DATA_ROOT=./data
TRAINER_TASK_SYSTEM_ROOT=./task_system
ACTRA_RUNTIME_STATE_ROOT=./runtime_state

ACTRA_HOSTED_PERSISTENCE_STRICT=1
ACTRA_HOSTED_DEV_AUTH_BRIDGE=1
ACTRA_ENABLE_HOSTED_SHADOW_WRITE_FALLBACK=0
ACTRA_HOSTED_USE_WAITRESS=0
FLASK_DEBUG=1

ACTRA_SECRET_KEY=replace-with-local-dev-secret

ACTRA_SESSION_COOKIE_SECURE=0
ACTRA_SESSION_COOKIE_SAMESITE=Lax
ACTRA_AUTH_SESSION_TTL_DAYS=30

ACTRA_UPDATE_CHECK_ENABLED=0

ACTRA_AUTH_EMAIL_ENABLED=1
ACTRA_AUTH_PUBLIC_BASE_URL=http://localhost:8000
ACTRA_AUTH_SMTP_HOST=127.0.0.1
ACTRA_AUTH_SMTP_PORT=1025
ACTRA_AUTH_SMTP_USER=
ACTRA_AUTH_SMTP_FROM=auth@localhost.test
# Add ACTRA_AUTH_SMTP_PASSWORD in your local .env.localhost only if your SMTP relay requires auth.
ACTRA_AUTH_SMTP_USE_TLS=0
ACTRA_AUTH_SMTP_USE_SSL=0

ACTRA_GOOGLE_AUTH_ENABLED=0
ACTRA_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
ACTRA_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
ACTRA_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
ACTRA_GOOGLE_HOSTED_DOMAIN=

ACTRA_FEEDBACK_EMAIL_ENABLED=0

POSTGRES_PASSWORD=replace-with-local-postgres-password
ACTRA_POSTGRES_DSN=postgresql://actra:replace-with-local-postgres-password@127.0.0.1:5432/actra

ACTRA_S3_ENDPOINT=http://127.0.0.1:9000
ACTRA_S3_BUCKET=actra
ACTRA_S3_ACCESS_KEY=minioadmin
ACTRA_S3_SECRET_KEY=minioadmin

# Paddle Billing API v2
PADDLE_ENVIRONMENT=production
PADDLE_CLIENT_TOKEN=replace-with-paddle-client-token
PADDLE_API_KEY=replace-with-paddle-api-key
PADDLE_WEBHOOK_SECRET=replace-with-paddle-webhook-secret
